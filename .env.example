# Environment configuration for Sakhi
# In production, sensitive variables can be loaded from Google Secret Manager

APP_NAME="Sakhi – आपकी आवाज़ दीदी"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Google Cloud Settings
GCP_PROJECT_ID=""
USE_SECRET_MANAGER=false

# Gemini API
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_API_KEY=""

# Google Maps API
GOOGLE_MAPS_API_KEY=""

# Firestore
FIRESTORE_DATABASE="(default)"
FIRESTORE_SESSION_TTL_HOURS=24

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]
TRUSTED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_CHAT="20/minute"
RATE_LIMIT_VOICE="20/minute"
RATE_LIMIT_VISION="5/minute"
