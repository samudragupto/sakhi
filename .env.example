# Environment configuration for Sakhi
# In production, secrets are mounted as env vars by Cloud Run from Secret Manager

APP_NAME="Sakhi – आपकी आवाज़ दीदी"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Google Cloud Settings (Vertex AI uses ADC)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# Gemini model
GEMINI_MODEL="gemini-2.5-flash"

# Google Maps API (mounted from Secret Manager in Cloud Run)
MAPS_API_KEY=""

# Firestore
FIRESTORE_COLLECTION="sessions"
FIRESTORE_DATABASE="(default)"
FIRESTORE_SESSION_TTL_HOURS=24

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_CHAT="20/minute"
RATE_LIMIT_VOICE="20/minute"
RATE_LIMIT_VISION="5/minute"
